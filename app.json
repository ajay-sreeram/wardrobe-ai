{
  "expo": {
    "name": "Wardrobe",
    "slug": "wardrobe-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/icon.png",
    "scheme": "wardrobeai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/branding/icon.png",
      "bundleIdentifier": "com.sreeram-ajay.wardrobe-ai",
      "appleTeamId": "9F4H5JDXW7"
    },
    "android": {
      "icon": "./assets/branding/icon.png",
      "predictiveBackGestureEnabled": false,
      "package": "com.sreeramajay.wardrobeai"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/branding/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F4EF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#111411",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Wardrobe to select only the garment photos you choose.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
