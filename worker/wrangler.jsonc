{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wardrobe-ai-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_ORIGINS": "*",
    "APPLE_BUNDLE_ID": "com.sreeram-ajay.wardrobe-ai",
    "APPLE_TEAM_ID": "9F4H5JDXW7",
    "INTEGRITY_MODE": "report-only"
  },
  "secrets": {
    "required": ["MUSE_API_KEY", "GEMINI_API_KEY", "SESSION_SECRET"]
  },
  "d1_databases": [
    {
      "binding": "ATTEST_DB",
      "database_name": "wardrobe-ai-integrity",
      "database_id": "0d7c1e0e-1931-407e-a2cf-9ce6bb58132f"
    }
  ],
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
