{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wardrobe-ai-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-16",
  "vars": {
    "ALLOWED_ORIGINS": "*"
  },
  "secrets": {
    "required": ["MUSE_API_KEY", "GEMINI_API_KEY"]
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
